{
  "name": "geospt",
  "private": true,
  "version": "2.0.7",
  "type": "module",
  "description": "GeoSPT — Análise SPT e capacidade de carga de estacas (Décourt-Quaresma + Aoki-Velloso)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
